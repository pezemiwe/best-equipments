# Copy to .env.local (dev) or set in your hosting provider (production).

# Admin portal password (REQUIRED in production, minimum 12 characters - default is best-equipments-admin)
ADMIN_PASSWORD=

# Secret used to sign admin session tokens (REQUIRED in production)
ADMIN_SECRET=

# Neon Postgres connection string (REQUIRED in production).
# (from console.neon.tech > your project > Connection Details).
# Tables are created and seeded automatically on first request.
# If unset, a local JSON file store is used (dev only).
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Set to "file" to force the local JSON store even when DATABASE_URL is set
# STORE_BACKEND=file

# Set to "true" to populate the catalog with demo products on first launch.
# In production, this should be unset or "false" to start with an empty catalog.
# SEED_DEMO_DATA=true

# Admin email address for receiving order notifications.
# ADMIN_EMAIL=admin@bestqualities.com

# SMTP configuration for sending emails (e.g., order confirmations).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_SECURE=false
