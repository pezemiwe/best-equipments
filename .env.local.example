# Copy to .env.local (dev) or set in your hosting provider (production).

# Admin portal password (REQUIRED in production - default is maise-admin)
ADMIN_PASSWORD=

# Secret used to sign admin session tokens (REQUIRED in production)
ADMIN_SECRET=

# Neon Postgres connection string (from console.neon.tech > your project >
# Connection Details). Tables are created and seeded automatically on first
# request. If unset, a local JSON file store is used (dev only).
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Set to "file" to force the local JSON store even when DATABASE_URL is set
# STORE_BACKEND=file
